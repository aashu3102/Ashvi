# PostgreSQL
DATABASE_URL="postgresql://USERNAME:PASSWORD@localhost:5432/ashvi?schema=public"

# Server
ASHVI_SERVER_PORT=4000
ASHVI_FRONTEND_URL=http://localhost:3000
ASHVI_LOG_LEVEL=info
NEXT_PUBLIC_ASHVI_API_URL=http://127.0.0.1:4000

# Local AI provider
ASHVI_AI_PROVIDER=ollama
ASHVI_AI_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
ASHVI_STT_COMMAND=faster-whisper
ASHVI_STT_ARGS=["--model","{model}","--language","{language}","--output","{output}","{input}"]
ASHVI_STT_MODEL=small
ASHVI_TTS_COMMAND=piper
ASHVI_TTS_ARGS=["--model","{model}","--output_file","{output}"]
ASHVI_TTS_MODEL=
ASHVI_TTS_MODEL_EN=
ASHVI_TTS_MODEL_HI=
ASHVI_VOICE_COMMAND_TIMEOUT_MS=60000

# Private access: generate Argon2id hashes locally; never put raw credentials here.
ASHVI_SESSION_SECRET=replace-with-at-least-32-random-characters
ASHVI_USER_A_NAME=authorized-user-a
ASHVI_USER_A_CODE_HASH=$argon2id$replace-with-generated-hash
ASHVI_USER_A_PASSWORD_HASH=$argon2id$replace-with-generated-hash
ASHVI_USER_B_NAME=authorized-user-b
ASHVI_USER_B_CODE_HASH=$argon2id$replace-with-generated-hash
ASHVI_USER_B_PASSWORD_HASH=$argon2id$replace-with-generated-hash
